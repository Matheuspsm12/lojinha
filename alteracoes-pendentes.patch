 .fotos-edicao .adicionar{border:2px dashed var(--lilas);display:grid;place-items:center;color:var(--ametista);font-size:.8rem;text-align:center;cursor:pointer;background:#fff}
+.galeria-produto{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-top:10px}
+.galeria-item{border:1px solid var(--linha);border-radius:12px;overflow:hidden;background:#fff}
+.galeria-item.capa{border-color:var(--ouro);box-shadow:0 0 0 1px var(--ouro)}
+.galeria-item .imagem{aspect-ratio:1;background:var(--lilas-claro);position:relative}
+.galeria-item .imagem img,.galeria-item .imagem svg{width:100%;height:100%;object-fit:cover;display:block}
+.galeria-item .selo-capa{position:absolute;left:8px;top:8px;background:var(--ouro-claro);color:var(--ametista-escuro);font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:99px}
+.galeria-item .acoes{display:flex;gap:4px;padding:8px;flex-wrap:wrap;justify-content:center}
+.galeria-item .acoes button{min-height:32px;padding:0 10px;font-size:.82rem;border-radius:99px;border:1.5px solid var(--linha);background:#fff;cursor:pointer;color:var(--ametista)}
+.galeria-item .acoes button:hover{background:var(--lilas-claro)}
+.galeria-item .acoes button.excluir{color:var(--perigo);border-color:#e7b9c2}
+.galeria-item .acoes button:disabled{opacity:.45;cursor:not-allowed}
+.galeria-vazia{border:2px dashed var(--lilas);border-radius:12px;padding:18px;text-align:center;color:var(--tinta-suave);background:var(--lilas-claro)}
 .envio-fotos{border:2px dashed var(--lilas);border-radius:var(--raio);padding:16px;text-align:center;background:var(--lilas-claro);margin-bottom:12px}
 .envio-fotos.arrastando{border-color:var(--ouro);background:var(--ouro-palido)}
 .envio-fotos p{margin:6px 0 10px;color:var(--tinta-suave);font-size:.9rem}
