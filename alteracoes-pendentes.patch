+    /// <summary>
+    /// Lista pronta para o campo de categoria do cadastro de produtos: categorias e subcategorias
+    /// ativas, já na ordem e com o caminho montado ("Coletes › Colete de Apará").
+    /// Ao editar um produto, passe o id da categoria atual em <c>incluirId</c>: ela entra na lista
+    /// mesmo desativada, para o produto não perder o vínculo.
+    /// </summary>
+    [HttpGet("opcoes")]
+    public async Task<List<CategoriaOpcaoDto>> Opcoes([FromQuery] Guid? incluirId)
+    {
+        var todas = await db.Categorias.AsNoTracking().OrderBy(c => c.Ordem).ThenBy(c => c.Nome).ToListAsync();
+        var produtos = await db.Produtos.AsNoTracking()
+            .GroupBy(p => p.CategoriaId).Select(g => new { g.Key, Qtd = g.Count() })
+            .ToDictionaryAsync(x => x.Key, x => x.Qtd);
+
+        var opcoes = new List<CategoriaOpcaoDto>();
+        foreach (var pai in todas.Where(c => c.CategoriaPaiId is null))
+        {
+            var subs = todas.Where(s => s.CategoriaPaiId == pai.Id).ToList();
+            if (Mostrar(pai)) opcoes.Add(Montar(pai, null));
+            foreach (var sub in subs.Where(Mostrar)) opcoes.Add(Montar(sub, pai));
+        }
+        return opcoes;
+
+        bool Mostrar(Categoria c) => c.Ativa || c.Id == incluirId;
+        CategoriaOpcaoDto Montar(Categoria c, Categoria? pai) => new(
+            c.Id, c.Nome, pai?.Nome,
+            pai is null ? c.Nome : $"{pai.Nome} › {c.Nome}",
+            c.Ativa, pai is not null, produtos.GetValueOrDefault(c.Id));
+    }
+
